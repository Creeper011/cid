include { ".env" }

;> the yumly lang is an mvp.. and i gonna add other config <;
(app) {
    name = "Cid",
    version = "0.1.0",
    (discord) {
        token ;env = $["TOKEN"],
        prefix = "c!"
    },
    (audios) {
        audio_path ;string = "./audios",
        default_interval_seconds ;float = 60.0,
        default_provability_percent ;int = 50
    }
}